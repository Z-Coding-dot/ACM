# Production Laravel template for Namecheap shared hosting.
# Copy to /home/CPANEL_USER/acm-backend/.env, outside public_html.
APP_NAME=ACM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
FRONTEND_URL=https://example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Use full database/user names from cPanel, including its prefix.
# mysql also connects to Namecheap's MariaDB service via the MySQL protocol.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_USER_acm
DB_USERNAME=CPANEL_USER_acm
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_COOKIE=acm_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=example.com
CORS_ALLOWED_ORIGINS=https://example.com
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning

# Use the SMTP settings and verified sender from your email provider.
# smtp/587 uses STARTTLS; use smtps/465 if required by your provider.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ACM
MAIL_TIMEOUT=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback

ACM_BUSINESSES_PER_USER=
ACM_CUSTOMERS_PER_BUSINESS=
ACM_SERVICES_PER_BUSINESS=
ACM_STAFF_PER_BUSINESS=
